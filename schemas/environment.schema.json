{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://timelabs-npo.github.io/omnia-playbook/schemas/environment.schema.json",
  "title": "Environment (Target Estate Declaration)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "version",
    "layer",
    "name",
    "runtime_host",
    "estate_targets",
    "description"
  ],
  "properties": {
    "id": { "type": "string", "minLength": 2 },
    "version": { "type": "string", "minLength": 1, "pattern": "^[^\\s]+$" },
    "layer": { "type": "string", "enum": ["normative", "operational", "explanatory"], "const": "operational" },
    "name": { "type": "string", "minLength": 2 },
    "description": { "type": "string", "minLength": 5 },
    "runtime_host": {
      "type": "object",
      "additionalProperties": false,
      "required": ["platform", "vendor", "adapter_id_hint", "host_substrate_only"],
      "properties": {
        "platform": { "type": "string", "minLength": 2 },
        "vendor": { "type": "string", "minLength": 2 },
        "adapter_id_hint": { "type": "string", "minLength": 3 },
        "host_substrate_only": { "type": "boolean", "const": true }
      }
    },
    "estate_targets": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["target_id", "platform", "vendor", "adapter_id_hint", "capabilities_required"],
        "properties": {
          "target_id": { "type": "string", "minLength": 2 },
          "platform": { "type": "string", "minLength": 2 },
          "vendor": { "type": "string", "minLength": 2 },
          "adapter_id_hint": { "type": "string", "minLength": 3 },
          "capabilities_required": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 3 }
          },
          "evidence_tier_minimum": {
            "type": "string",
            "enum": ["declared_only", "implemented", "validated_mock", "validated_live_target"]
          }
        }
      }
    },
    "adapters_legacy_list": {
      "type": "array",
      "description": "Legacy adapter directory references kept for transition. Runtime must prefer estate_targets[*].adapter_id_hint and check manifest support_tier.",
      "minItems": 0,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 2 }
    },
    "owner_intent_refs": {
      "type": "array",
      "description": "References to owner_operational_intent artifacts that apply when evaluating this environment's estate.",
      "minItems": 0,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 3 }
    },
    "disagreement_resolution_refs": {
      "type": "array",
      "description": "References to disagreement_resolution artifacts that govern Tribunal participant claim conflicts within this environment.",
      "minItems": 0,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 3 }
    }
  }
}
