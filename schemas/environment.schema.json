{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://timelabs-npo.github.io/omnia-playbook/schemas/environment.schema.json",
  "title": "Environment",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "name", "description", "platforms", "adapters"],
  "properties": {
    "id": { "type": "string", "minLength": 2 },
    "name": { "type": "string", "minLength": 2 },
    "description": { "type": "string", "minLength": 5 },
    "platforms": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 2 }
    },
    "adapters": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 2 }
    }
  }
}
