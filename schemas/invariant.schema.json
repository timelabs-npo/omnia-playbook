{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://timelabs-npo.github.io/omnia-playbook/schemas/invariant.schema.json",
  "title": "Invariant",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "title",
    "description",
    "rationale",
    "scope",
    "severity",
    "platforms",
    "expected_state",
    "check",
    "remediation",
    "sources",
    "last_verified"
  ],
  "properties": {
    "id": { "type": "string", "minLength": 3 },
    "title": { "type": "string", "minLength": 3 },
    "description": { "type": "string", "minLength": 5 },
    "rationale": { "type": "string", "minLength": 5 },
    "scope": { "type": "string", "minLength": 3 },
    "severity": { "type": "string", "enum": ["low", "medium", "high", "critical"] },
    "platforms": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 2 }
    },
    "expected_state": { "type": "object" },
    "check": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ids"],
      "properties": {
        "ids": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 3 }
        }
      }
    },
    "remediation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["playbook"],
      "properties": {
        "playbook": { "type": "string", "minLength": 3 }
      }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 3 }
    },
    "last_verified": { "type": "string", "format": "date" }
  }
}
