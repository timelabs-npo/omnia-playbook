{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://timelabs-npo.github.io/omnia-playbook/schemas/adapter.schema.json",
  "title": "Adapter (Dumb Observation Provider, no authority)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "name",
    "version",
    "layer",
    "ontology",
    "support_tier",
    "status",
    "evidence_tier_claims",
    "evidence_tier_support",
    "authority_ceiling",
    "forbidden_actions",
    "description",
    "primary_platforms",
    "primary_vendors",
    "declared_capabilities",
    "last_verified"
  ],
  "properties": {
    "id": { "type": "string", "minLength": 3 },
    "name": { "type": "string", "minLength": 3 },
    "version": { "type": "string", "minLength": 1, "pattern": "^[^\\s]+$" },
    "layer": { "type": "string", "enum": ["normative", "operational", "explanatory"], "const": "operational" },
    "ontology": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "platform_vendor", "platform_name", "vendor_name"],
      "properties": {
        "type": {
          "type": "string",
          "enum": ["operating_system", "cloud_vendor", "device_operating_system", "cloud_platform_vendor", "cloud_vendor_operating_system", "vendor_platform_operating_system", "vendor_platform"]
        },
        "platform_vendor": {
          "type": "string",
          "enum": ["operating_system", "cloud_vendor", "operating_system_vendor", "cloud_platform", "vendor_platform"]
        },
        "platform_name": { "type": "string", "minLength": 2 },
        "vendor_name": { "type": "string", "minLength": 2 },
        "interface_type": {
          "type": "string",
          "enum": ["base_system_command", "base_system_file", "rest_api", "cli_wrapper", "shell_script"]
        },
        "adapter_is_evidence_provider_only": { "type": "boolean" }
      }
    },
    "support_tier": {
      "type": "string",
      "enum": ["unsupported", "advisory", "supported"]
    },
    "status": {
      "type": "string",
      "enum": ["declared_only", "implemented", "validated_mock", "validated_live_target", "proposed", "deprecated", "UNIMPLEMENTED", "MAPPED", "VALIDATED"]
    },
    "evidence_tier_claims": {
      "type": "object",
      "additionalProperties": false,
      "required": ["declared_only", "implemented", "validated_mock", "validated_live_target", "adapter_does_not_decide_truth"],
      "properties": {
        "declared_only": { "type": "boolean" },
        "implemented": { "type": "boolean" },
        "validated_mock": { "type": "boolean" },
        "validated_live_target": { "type": "boolean" },
        "adapter_does_not_decide_truth": { "type": "boolean", "const": true }
      }
    },
    "evidence_tier_support": {
      "type": "object",
      "additionalProperties": false,
      "required": ["highest_tier_for_supported_capability", "mock_not_equivalent_to_live", "live_tier_requires_provenance_ref"],
      "properties": {
        "highest_tier_for_supported_capability": {
          "type": "string",
          "enum": ["declared_only", "implemented", "validated_mock", "validated_live_target"]
        },
        "mock_not_equivalent_to_live": { "type": "boolean", "const": true },
        "live_tier_requires_provenance_ref": { "type": "boolean", "const": true }
      }
    },
    "authority_ceiling": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_authority", "decides_truth", "decides_policy", "decides_remediation", "output_is_typed_untrusted_evidence"],
      "properties": {
        "max_authority": {
          "type": "string",
          "enum": ["read_only_evidence", "advisory_remediation_only"]
        },
        "decides_truth": { "type": "boolean", "const": false },
        "decides_policy": { "type": "boolean", "const": false },
        "decides_remediation": { "type": "boolean", "const": false },
        "output_is_typed_untrusted_evidence": { "type": "boolean", "const": true }
      }
    },
    "forbidden_actions": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "action", "reason"],
        "properties": {
          "id": { "type": "string", "minLength": 3 },
          "action": { "type": "string", "minLength": 5 },
          "reason": { "type": "string", "minLength": 8 }
        }
      }
    },
    "description": { "type": "string", "minLength": 10 },
    "primary_platforms": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 2 }
    },
    "primary_vendors": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 2 }
    },
    "declared_capabilities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "operation",
          "mode",
          "status",
          "evidence_tier",
          "description",
          "sources"
        ],
        "properties": {
          "id": { "type": "string", "minLength": 3 },
          "name": { "type": "string", "minLength": 3 },
          "operation": { "type": "string", "minLength": 3 },
          "mode": { "type": "string", "enum": ["read_only", "documentation_only", "mutating_admin_only"] },
          "interface_type": {
            "type": "string",
            "enum": ["base_system_command", "base_system_file", "rest_api", "cli_wrapper", "shell_script"]
          },
          "support_tier": {
            "type": "string",
            "enum": ["unsupported", "advisory", "supported"]
          },
          "status": {
            "type": "string",
            "enum": ["declared_only", "implemented", "validated_mock", "validated_live_target", "proposed", "deprecated", "UNIMPLEMENTED", "MAPPED", "VALIDATED"]
          },
          "evidence_tier": {
            "type": "string",
            "enum": ["declared_only", "implemented", "validated_mock", "validated_live_target"]
          },
          "observation_contract": {
            "type": "object",
            "additionalProperties": false,
            "required": ["observations", "output_schema"],
            "properties": {
              "observations": {
                "type": "array",
                "minItems": 0,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["id", "type", "optional"],
                  "properties": {
                    "id": { "type": "string", "minLength": 3 },
                    "type": {
                      "type": "string",
                      "minLength": 3
                    },
                    "optional": { "type": "boolean" }
                  }
                }
              },
              "output_schema": {
                "type": "object",
                "additionalProperties": false,
                "required": ["format"],
                "properties": {
                  "format": {
                    "type": "string",
                    "enum": ["line_based_kv", "json_lines", "json_object", "stdout_lines_presence", "none_documentation_only"]
                  },
                  "encoding": { "type": "string" },
                  "top_level_keys": {
                    "type": "array",
                    "items": { "type": "string" }
                  }
                }
              }
            }
          },
          "unknown_semantics": {
            "type": "object",
            "additionalProperties": false,
            "required": ["when_observation_missing", "when_command_missing"],
            "properties": {
              "when_observation_missing": {
                "type": "string",
                "enum": ["UNKNOWN", "ERROR"]
              },
              "when_command_missing": {
                "type": "string",
                "enum": ["UNKNOWN", "ERROR", "UNSUPPORTED"]
              }
            }
          },
          "error_semantics": {
            "type": "object",
            "additionalProperties": false,
            "required": ["on_timed_out", "on_unauthorized_call"],
            "properties": {
              "on_timed_out": {
                "type": "string",
                "enum": ["ERROR", "UNKNOWN"]
              },
              "on_unauthorized_call": {
                "type": "string",
                "enum": ["ERROR", "UNSUPPORTED"]
              }
            }
          },
          "description": { "type": "string", "minLength": 10 },
          "sources": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 2 }
          },
          "evidence": {
            "type": "object",
            "additionalProperties": false,
            "required": ["type", "references"],
            "properties": {
              "type": {
                "type": "string",
                "enum": ["check_reference", "schema_fixture", "unit_test", "script_contract", "live_hardware_plan"]
              },
              "references": {
                "type": "array",
                "minItems": 1,
                "items": { "type": "string", "minLength": 2 }
              }
            }
          },
          "evidence_notes": { "type": "string" },
          "version": { "type": "string", "minLength": 1, "pattern": "^[^\\s]+$" },
          "provenance_refs": {
            "type": "array",
            "items": { "type": "string", "minLength": 2 }
          }
        }
      }
    },
    "validated_capability_ids": {
      "type": "array",
      "minItems": 0,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 3 }
    },
    "last_verified": { "type": "string", "format": "date" },
    "notes": { "type": "string" }
  }
}
