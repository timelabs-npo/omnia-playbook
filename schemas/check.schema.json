{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://timelabs-npo.github.io/omnia-playbook/schemas/check.schema.json",
  "title": "Check",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "invariant",
    "command",
    "platform",
    "requires",
    "timeout",
    "expected_exit_code",
    "expected_output",
    "failure_message",
    "remediation_playbook"
  ],
  "properties": {
    "id": { "type": "string", "minLength": 3 },
    "invariant": { "type": "string", "minLength": 3 },
    "command": { "type": "string", "minLength": 1 },
    "platform": { "type": "string", "minLength": 2 },
    "requires": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "timeout": { "type": "integer", "minimum": 1 },
    "expected_exit_code": { "type": "integer", "minimum": 0 },
    "expected_output": { "type": "object" },
    "failure_message": { "type": "string", "minLength": 3 },
    "remediation_playbook": { "type": "string", "minLength": 3 }
  }
}
