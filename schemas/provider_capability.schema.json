{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://timelabs-npo.github.io/omnia-playbook/schemas/provider_capability.schema.json",
  "title": "Omnia v1 Provider Capability Contract (evidence-only boundary, no policy, no truth claim)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "provider_id",
    "name",
    "version",
    "layer",
    "family",
    "evidence_class_declared",
    "authority_boundary",
    "output_is_typed_evidence_only",
    "capabilities",
    "unknown_semantics",
    "error_semantics",
    "degraded_offline_semantics",
    "last_verified"
  ],
  "properties": {
    "schema_version": { "type": "string", "const": "omnia.provider.v1" },
    "provider_id": { "type": "string", "minLength": 5 },
    "name": { "type": "string", "minLength": 3 },
    "version": { "type": "string", "minLength": 1, "pattern": "^[^\\s]+$" },
    "layer": { "type": "string", "const": "normative" },
    "family": {
      "type": "string",
      "enum": [
        "DNS",
        "GNS",
        "SCION",
        "BGP_OPENBGPD",
        "RPKI",
        "LOCAL_OBSERVATION",
        "ACTIVE_PROBE",
        "LIBP2P_LIKE_DISCOVERY",
        "QUIC_PATH_OBSERVATION",
        "MBSD_OPENBSD_OBSERVATION",
        "WIREGUARD_OBSERVATION",
        "MDNS_DNS_SD",
        "ICE_STUN_TURN",
        "MASQUE_TUNNEL",
        "FUTURE_PROVIDER"
      ]
    },
    "description": { "type": "string", "minLength": 20 },
    "evidence_class_declared": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "may_report_identities",
        "may_report_names",
        "may_report_locators",
        "may_report_paths",
        "may_report_reachability",
        "may_report_routing_state",
        "may_report_trust_assertions",
        "may_report_observations",
        "may_report_capabilities",
        "may_report_failure_state"
      ],
      "properties": {
        "may_report_identities": { "type": "boolean" },
        "may_report_names": { "type": "boolean" },
        "may_report_locators": { "type": "boolean" },
        "may_report_paths": { "type": "boolean" },
        "may_report_reachability": { "type": "boolean" },
        "may_report_routing_state": { "type": "boolean" },
        "may_report_trust_assertions": { "type": "boolean" },
        "may_report_observations": { "type": "boolean" },
        "may_report_capabilities": { "type": "boolean" },
        "may_report_failure_state": { "type": "boolean" }
      }
    },
    "authority_boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "must_not_decide_omnia_policy",
        "must_not_grant_itself_authority",
        "must_not_claim_semantic_truth",
        "must_not_mutate_external_state_unasked",
        "provider_is_replaceable"
      ],
      "properties": {
        "must_not_decide_omnia_policy": { "type": "boolean", "const": true },
        "must_not_grant_itself_authority": { "type": "boolean", "const": true },
        "must_not_claim_semantic_truth": { "type": "boolean", "const": true },
        "must_not_mutate_external_state_unasked": { "type": "boolean", "const": true },
        "provider_is_replaceable": { "type": "boolean", "const": true },
        "forbidden_ontology_promotion_reasons": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 15 }
        }
      }
    },
    "output_is_typed_evidence_only": { "type": "boolean", "const": true },
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "operation", "evidence_tier_max", "output_schema_ref", "privacy_tier_output"],
        "properties": {
          "id": { "type": "string", "minLength": 3 },
          "operation": { "type": "string", "minLength": 3 },
          "evidence_tier_max": { "type": "string", "enum": ["declared_only", "implemented", "validated_mock", "validated_live_target"] },
          "output_schema_ref": { "type": "string", "minLength": 3 },
          "privacy_tier_output": { "type": "string", "enum": ["PUBLIC", "PRIVATE", "LOCAL_ONLY_RAW", "DERIVED_BOOLEAN"] },
          "provenance_required": { "type": "boolean", "const": true }
        }
      }
    },
    "unknown_semantics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["when_provider_unreachable", "when_output_malformed"],
      "properties": {
        "when_provider_unreachable": { "type": "string", "enum": ["UNKNOWN", "ERROR", "FAIL"] },
        "when_output_malformed": { "type": "string", "enum": ["ERROR", "UNKNOWN", "FAIL"] }
      }
    },
    "error_semantics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["on_timed_out", "on_unauthorized"],
      "properties": {
        "on_timed_out": { "type": "string", "enum": ["ERROR", "UNKNOWN"] },
        "on_unauthorized": { "type": "string", "enum": ["ERROR", "FAIL"] }
      }
    },
    "degraded_offline_semantics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["has_declared_offline_behavior", "offline_behavior_never_silently_pass"],
      "properties": {
        "has_declared_offline_behavior": { "type": "boolean", "const": true },
        "offline_behavior_never_silently_pass": { "type": "boolean", "const": true },
        "local_cache_trust_horizon_seconds": { "type": "integer", "minimum": 0 },
        "offline_result": { "type": "string", "enum": ["UNKNOWN", "ERROR", "LAST_KNOWN_GOOD_ONLY"] }
      }
    },
    "openbsd_support_tier": {
      "type": "string",
      "enum": [
        "OPENBSD_BASE_AVAILABLE",
        "OPENBSD_PORT_AVAILABLE",
        "MOCK_TESTED",
        "VM_TESTED",
        "REAL_HOST_TESTED",
        "BERYL_TESTED",
        "UNKNOWN"
      ]
    },
    "last_verified": { "type": "string", "format": "date" },
    "notes": { "type": "string" }
  }
}
