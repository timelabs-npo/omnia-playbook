{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://timelabs-npo.github.io/omnia-playbook/schemas/log-event.schema.json",
  "title": "Omnia log.0 event",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "event_id",
    "sequence",
    "observed_at",
    "kind",
    "status",
    "source",
    "subject",
    "payload",
    "redaction",
    "previous_digest",
    "digest"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "event_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "sequence": { "type": "integer", "minimum": 1 },
    "observed_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "kind": {
      "type": "string",
      "enum": [
        "observation",
        "finding",
        "plan",
        "approval",
        "execution",
        "verification",
        "reversal"
      ]
    },
    "status": {
      "type": "string",
      "enum": ["PASS", "FAIL", "UNKNOWN", "ERROR"]
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["adapter", "collector", "version"],
      "properties": {
        "adapter": { "type": "string", "minLength": 1, "maxLength": 80 },
        "collector": { "type": "string", "minLength": 1, "maxLength": 120 },
        "version": { "type": "string", "minLength": 1, "maxLength": 40 }
      }
    },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "ref"],
      "properties": {
        "type": { "type": "string", "minLength": 1, "maxLength": 40 },
        "ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160,
          "pattern": "^[A-Za-z0-9._:/-]+$"
        }
      }
    },
    "payload": { "type": "object" },
    "redaction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["policy", "applied"],
      "properties": {
        "policy": { "type": "string", "minLength": 1, "maxLength": 80 },
        "applied": { "const": true }
      }
    },
    "previous_digest": {
      "oneOf": [
        { "type": "null" },
        { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      ]
    },
    "digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
  }
}
