{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://timelabs-npo.github.io/omnia-playbook/schemas/evidence_privacy_tier.schema.json",
  "title": "Omnia v1 Evidence Privacy / Redaction Tier Contract (PUBLIC/PRIVATE/LOCAL_RAW/DERIVED_BOOL separation)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "tier_set_id",
    "version",
    "layer",
    "tiers",
    "public_exposure_minimum_rule",
    "leakage_audits_required",
    "redaction_contract_version"
  ],
  "properties": {
    "schema_version": { "type": "string", "const": "omnia.evidence_privacy.v1" },
    "tier_set_id": { "type": "string", "minLength": 5 },
    "version": { "type": "string", "minLength": 1, "pattern": "^[^\\s]+$" },
    "layer": { "type": "string", "const": "normative" },
    "tiers": {
      "type": "object",
      "additionalProperties": false,
      "required": ["PUBLIC_EVIDENCE", "PRIVATE_EVIDENCE", "LOCAL_ONLY_RAW_OBSERVATION", "DERIVED_BOOLEAN_POSTURE"],
      "properties": {
        "PUBLIC_EVIDENCE": {
          "type": "object",
          "additionalProperties": false,
          "required": ["definition", "allowed_leakage_surface", "machine_consumable_only_minimum"],
          "properties": {
            "definition": { "type": "string", "minLength": 20 },
            "allowed_leakage_surface": { "type": "array", "items": { "type": "string", "minLength": 5 }, "uniqueItems": true, "minItems": 1 },
            "machine_consumable_only_minimum": { "type": "boolean", "const": true }
          }
        },
        "PRIVATE_EVIDENCE": {
          "type": "object",
          "additionalProperties": false,
          "required": ["definition", "handling_required", "must_not_be_public_output"],
          "properties": {
            "definition": { "type": "string", "minLength": 20 },
            "handling_required": { "type": "array", "items": { "type": "string", "minLength": 5 }, "uniqueItems": true, "minItems": 1 },
            "must_not_be_public_output": { "type": "boolean", "const": true }
          }
        },
        "LOCAL_ONLY_RAW_OBSERVATION": {
          "type": "object",
          "additionalProperties": false,
          "required": ["definition", "must_not_leave_host", "forbidden_publication"],
          "properties": {
            "definition": { "type": "string", "minLength": 20 },
            "must_not_leave_host": { "type": "boolean", "const": true },
            "forbidden_publication": { "type": "array", "items": { "type": "string", "minLength": 5 }, "uniqueItems": true, "minItems": 1 }
          }
        },
        "DERIVED_BOOLEAN_POSTURE": {
          "type": "object",
          "additionalProperties": false,
          "required": ["definition", "minimum_evidence_required", "must_not_reverse_engineer_raw"],
          "properties": {
            "definition": { "type": "string", "minLength": 20 },
            "minimum_evidence_required": { "type": "array", "items": { "type": "string", "minLength": 5 }, "uniqueItems": true, "minItems": 1 },
            "must_not_reverse_engineer_raw": { "type": "boolean", "const": true }
          }
        }
      }
    },
    "public_exposure_minimum_rule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rule_id", "expose_only_minimum_for_claim", "provenance_must_still_be_recorded_in_private"],
      "properties": {
        "rule_id": { "type": "string", "minLength": 3 },
        "expose_only_minimum_for_claim": { "type": "boolean", "const": true },
        "provenance_must_still_be_recorded_in_private": { "type": "boolean", "const": true }
      }
    },
    "leakage_audits_required": {
      "type": "object",
      "additionalProperties": false,
      "required": ["values", "nested_structures", "alternative_keys", "serialized_blobs", "hostnames", "resolver_data", "addresses", "interface_names", "topology", "routing_state", "timing", "identifiers"],
      "properties": {
        "values": { "type": "boolean", "const": true },
        "nested_structures": { "type": "boolean", "const": true },
        "alternative_keys": { "type": "boolean", "const": true },
        "serialized_blobs": { "type": "boolean", "const": true },
        "hostnames": { "type": "boolean", "const": true },
        "resolver_data": { "type": "boolean", "const": true },
        "addresses": { "type": "boolean", "const": true },
        "interface_names": { "type": "boolean", "const": true },
        "topology": { "type": "boolean", "const": true },
        "routing_state": { "type": "boolean", "const": true },
        "timing": { "type": "boolean", "const": true },
        "identifiers": { "type": "boolean", "const": true },
        "extra_channels": { "type": "array", "items": { "type": "string", "minLength": 5 }, "uniqueItems": true }
      }
    },
    "redaction_contract_version": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "privacy_not_comprehensive_unless_tested", "tier_non_promotion"],
      "properties": {
        "version": { "type": "string", "minLength": 1 },
        "privacy_not_comprehensive_unless_tested": { "type": "boolean", "const": true },
        "tier_non_promotion": {
          "type": "object",
          "additionalProperties": false,
          "required": ["local_raw_may_not_become_public_without_owner_explicit_approval"],
          "properties": {
            "local_raw_may_not_become_public_without_owner_explicit_approval": { "type": "boolean", "const": true }
          }
        }
      }
    },
    "notes": { "type": "string" }
  }
}
