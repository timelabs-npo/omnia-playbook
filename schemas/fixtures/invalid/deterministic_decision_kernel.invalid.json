{
  "schema_version": "omnia.decision_kernel.v1",
  "decision_id": "dk-invalid-v1",
  "decision_class_ref": "network_policy",
  "version": "1.0.0",
  "layer": "normative",
  "contract_kind": "boundary_only",
  "input_signature": {
    "typed_evidence_refs": ["obs-evidence"],
    "owner_intent_ref": "owner-intent-1",
    "policy_invariant_refs": ["inv-1"],
    "authority_ceiling_refs": ["ac-1"],
    "dependency_refs_required": []
  },
  "fail_closed_default": {
    "unknown_policy_becomes": "PASS",
    "malformed_evidence_becomes": "ERROR",
    "missing_evaluator_becomes": "ERROR",
