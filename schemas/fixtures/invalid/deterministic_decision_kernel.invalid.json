    "llm_output_cannot_override_denial": true,
    "escapes_fail_closed_to_pass": true
  },
  "output_enum": {
    "allowed": ["PASS", "FAIL", "UNKNOWN", "ERROR", "ESCALATE"],
    "pass_definition": "Passed.",
    "fail_definition": "Failed.",
    "unknown_definition": "Unknown.",
    "error_definition": "Error.",
    "escalate_definition": "Escalate.",
    "pass_cannot_be_forced_by_default": true
  },
  "receipt_version": {
    "version": "receipt.v1",
    "pins_policy_version": true,
    "pins_evidence_versions": true,
    "pins_engine_version": true,
    "pins_owner_intent_version": true,
    "required_receipt_fields": ["decision_id"]
  },
  "determinism_properties": {
    "identical_inputs_produce_identical_outputs": true,
    "serializable_inputs": true,
    "serializable_outputs": true,
    "replayable_without_live_network": true,
    "no_external_rng_in_eval": true,
    "no_clock_dependence_in_eval_unless_explicit": true
  },
  "compatibility": {
    "rheknel_status": "CANDIDATE_UNVALIDATED",
    "host_impl_status": "UNIMPLEMENTED",
    "future_engines_via_same_contract": true
  },
  "rheknel_must_not_be_hard_coded": true
}
