{
  "schema_version": "omnia.provider.v1",
  "provider_id": "pr-openbgpd-rpki-v1",
  "name": "OpenBGPD + rpki-client RPKI/ASPA Origin Validation Provider",
  "version": "9.0",
  "layer": "normative",
  "family": "BGP_OPENBGPD",
  "description": "OpenBGPD 9.0 (Dec 2025, -50% memory) + rpki-client(8) base evidence provider. Emits ROV/ASPA validation state; NEVER decides policy, NEVER claims semantic truth of a route.",
  "evidence_class_declared": {
    "may_report_identities": true,
    "may_report_names": false,
    "may_report_locators": true,
    "may_report_paths": true,
    "may_report_reachability": true,
    "may_report_routing_state": true,
    "may_report_trust_assertions": true,
    "may_report_observations": true,
    "may_report_capabilities": true,
    "may_report_failure_state": true
  },
  "authority_boundary": {
    "must_not_decide_omnia_policy": true,
    "must_not_grant_itself_authority": true,
    "must_not_claim_semantic_truth": true,
    "must_not_mutate_external_state_unasked": true,
    "provider_is_replaceable": true,
    "forbidden_ontology_promotion_reasons": [
      "BGP does not equal routing ontology; replaceable with Babel, SCION-IP GW, static routes.",
      "RPKI is origin validation, not global reachability truth; ASPA Aug 2026 enforcement partial.",
      "rpki-client manifest-gap warnings, ARIN TAL unencumbered, March-2027 3y-TA cut pending."
    ]
  },
  "output_is_typed_evidence_only": true,
  "capabilities": [
    {
      "id": "cap-openbgpd-rib-ipv4-ipv6",
      "operation": "bgpctl.show.rib",
      "evidence_tier_max": "validated_live_target",
      "output_schema_ref": "out-openbgpd-rib-json",
      "privacy_tier_output": "DERIVED_BOOLEAN",
      "provenance_required": true
    },
    {
      "id": "cap-rpki-roa-valid",
      "operation": "rpki-client.rov.report",
      "evidence_tier_max": "validated_mock",
      "output_schema_ref": "out-rpki-rov-counts",
      "privacy_tier_output": "PUBLIC",
      "provenance_required": true
    },
    {
      "id": "cap-rpki-aspa-validated",
      "operation": "rpki-client.aspa.report",
      "evidence_tier_max": "declared_only",
      "output_schema_ref": "out-rpki-aspa-counts",
      "privacy_tier_output": "PUBLIC",
      "provenance_required": true
    }
  ],
  "unknown_semantics": {
    "when_provider_unreachable": "UNKNOWN",
    "when_output_malformed": "ERROR"
  },
  "error_semantics": {
    "on_timed_out": "ERROR",
    "on_unauthorized": "FAIL"
  },
  "degraded_offline_semantics": {
    "has_declared_offline_behavior": true,
    "offline_behavior_never_silently_pass": true,
    "local_cache_trust_horizon_seconds": 0,
    "offline_result": "UNKNOWN"
  },
  "openbsd_support_tier": "OPENBSD_BASE_AVAILABLE",
  "last_verified": "2026-08-13",
  "notes": "OpenBSD 7.7 / 9.0. 20 May 2025 attribute injection event 150k flaps / 4 attack classes. PR #4 Trae lane sealed-brick environment only."
}
