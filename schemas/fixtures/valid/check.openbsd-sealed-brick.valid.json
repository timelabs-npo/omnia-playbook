    "when_command_missing": "UNKNOWN"
  },
  "error_semantics": {
    "on_timed_out": "ERROR",
    "on_contradictory_stdout": "ERROR",
    "on_unauthorized_subprocess": "ERROR"
  },
  "remediation_ref": "playbooks/openbsd-sealed-brick/README.md",
