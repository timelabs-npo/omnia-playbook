      {
        "key": "output_mode",
        "value_type": "string_exact",
        "match_rule": {"expected": "public_minimized"}
      },
      {
        "key": "result",
        "value_type": "string_exact",
        "match_rule": {"expected": "PASS"}
      }
    ]
  },
  "unknown_semantics": {
