{
  "id": "inv-example-001",
  "version": "1.0.0",
  "status": "validated_mock",
  "layer": "normative",
  "title": "Example Invariant Rule",
  "description": "Minimal valid invariant fixture covering all required fields for schema validation.",
  "scope": {
    "target_class": "developer_workstation",
    "tags": ["dns", "networking"]
  },
  "severity": "high",
  "runtime_host_independent": true,
  "applicability": {
    "target_platforms": ["macos", "linux"],
    "evidence_tier_minimum": "validated_mock"
  },
  "preconditions": {
    "expressions": [
      {
        "id": "pre-001",
        "rule": {
          "observation_exists": "obs-dns-config-present"
        },
        "message": "DNS configuration observation must exist"
      }
    ],
    "unknown_behavior": {
      "on_missing_observation": "UNKNOWN",
      "on_precondition_false": "SKIP_INAPPLICABLE"
    }
  },
  "required_observations": [
    {
      "id": "obs-dns-resolvers",
      "name": "DNS Resolvers List",
      "schema": {
        "type": "array",
        "minItems": 1,
        "maxItems": 3
      },
      "evidence_tier_required": "validated_mock",
      "provenance_required": {
        "signed": false,
        "adapter_operation_ref": "adapter-example.inspect.dns",
        "must_be_in_evidence_bundle": true
      }
    }
  ],
  "required_capabilities": ["cap-dns-inspect-v0"],
  "decision_rule": {
    "id": "dr-inv-001",
    "rule_type": "omnia_deterministic_v1",
    "version": "1.0",
    "observations_map": {
      "resolvers": "obs-dns-resolvers"
    },
    "logic": {
      "pass_if": [
        {
          "id": "pass-001",
          "expression": {
            "observation_equals": {}
          }
        }
      ],
      "fail_if": [
        {
          "id": "fail-001",
          "expression": {
            "observation_not_equals": {}
          },
          "message": "Resolver configuration does not match expected"
        }
      ],
      "unknown_if": [
        {
          "id": "unk-001",
          "expression": {
            "missing_observation": "obs-dns-resolvers"
          },
          "message": "DNS resolvers observation is missing"
        }
      ],
      "error_if": [
        {
          "id": "err-001",
          "expression": {
            "contradictory_observations": ["obs-a", "obs-b"]
          },
          "message": "Contradictory DNS observations received"
        }
      ]
    }
  },
  "outcomes": {
    "pass_semantics": "Invariant holds: DNS resolvers are explicitly configured and observable.",
    "fail_semantics": "Invariant fails: resolver configuration missing or non-deterministic.",
    "unknown_semantics": "Invariant unknown: required observations not yet materialized.",
    "error_semantics": "Invariant error: contradictory or malformed observation inputs."
  },
  "remediation_refs": {
    "playbook": "playbooks/recovery/example.md"
  },
  "source_refs": {
    "normative": ["foundation/networking.md"],
    "operational": [],
    "explanatory": []
  },
  "authority_ceiling": {
    "max_authority": "advisory_remediation_only",
    "no_promotion_reasoning": true,
    "forbidden_policy_domains": ["policy_widening", "unrestricted_egress"]
  },
  "forbidden_actions": [],
  "dependency_ids": [],
  "last_verified": "2026-08-13"
}
